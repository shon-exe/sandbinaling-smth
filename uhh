<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Character Pairing Registry</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .character-link:hover { text-decoration: underline; cursor: pointer; color: #3b82f6; }
        .tab-active { border-bottom: 2px solid #3b82f6; color: #3b82f6; }
    </style>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen p-4 md:p-8">

    <div class="max-w-4xl mx-auto">
        <header class="text-center mb-8">
            <h1 class="text-4xl font-bold text-white mb-2">Registry of Sandbina Server Pairings</h1>
            <p class="text-gray-400">Database of "Fanon" and Canon Relationships. Do not take this seriously, dm Shon if you want something removed! <3</p>
        </header>

        <div class="flex flex-col md:flex-row gap-4 mb-6">
            <input type="text" id="searchInput" placeholder="Search character or pairing..." 
                   class="bg-gray-800 border border-gray-700 rounded-lg px-4 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500">
            
            <div class="flex border-b border-gray-700">
                <button onclick="setTab('FANON')" id="tabFanon" class="px-6 py-2 tab-active font-semibold">FANON</button>
                <button onclick="setTab('CANON')" id="tabCanon" class="px-6 py-2 font-semibold">CANON</button>
            </div>
        </div>

        <div id="focusHeader" class="hidden bg-blue-900/30 border border-blue-500/50 p-4 rounded-lg mb-6 flex justify-between items-center">
            <span id="focusText" class="font-medium"></span>
            <button onclick="clearFocus()" class="text-sm bg-blue-500 hover:bg-blue-600 px-3 py-1 rounded">View All</button>
        </div>

        <div id="pairingsGrid" class="grid gap-4">
            </div>
    </div>

