                { name: "Shana/Shona", chars: ["Shon", "Hana"], desc: "Long term long distance medium effort lowkey on & off oomftuationship" },
                { name: "Shol", chars: ["Shon", "Sol"], desc: "Ruin me (in private), PREVIOUSLY the hertamei of the server." },
                { name: "Shev", chars: ["Shon", "Lev"], desc: "Lev ties shon's shoes.. Lev’s mom ships them" },
                { name: "Viva", chars: ["Vivian", "Saya"], desc: "Vivian foot" }
            ],
            CANON: [
                { name: "Cessbina", chars: ["Cessdrone", "Nekobina"], desc: "Divorced with benefits" },
                { name: "Frannyx", chars: ["Frannie", "Nyx"], desc: "Imported... frannie snuck in the sandbina server" },
                { name: "Beight", chars: ["B8", "Iolight"], desc: "Imported" },
                { name: "Evertrix", chars: ["Everday", "Zibai"], desc: "Imported" },
                { name: "Ashyuri", chars: ["Ashyy", "Notyuri"], desc: "Imported" },
                { name: "Estherveil", chars: ["Ester", "Moonveil"], desc: "HOMEGROWN & CANON!!!" },
                { name: "Peasy", chars: ["Peach", "Nessy"], desc: "Google doc is ready for them." }
            ]
        };

        let currentTab = 'FANON';
        let focusChar = null;

        function render() {
            const grid = document.getElementById('pairingsGrid');
            const search = document.getElementById('searchInput').value.toLowerCase();
            grid.innerHTML = '';

            const list = db[currentTab].filter(p => {
                const matchesSearch = p.name.toLowerCase().includes(search) || 
                                    p.chars.some(c => c.toLowerCase().includes(search));
                const matchesFocus = focusChar ? p.chars.includes(focusChar) : true;
                return matchesSearch && matchesFocus;
            });

            list.forEach(p => {
                const card = document.createElement('div');
                card.className = 'bg-gray-800 p-4 rounded-xl border border-gray-700 hover:border-blue-500 transition shadow-lg';
                
                const charLinks = p.chars.map(c => 
                    `<span class="character-link font-bold text-blue-400" onclick="filterByChar('${c}')">${c}</span>`
                ).join(' / ');

                card.innerHTML = `
                    <div class="flex justify-between items-start mb-2">
                        <h3 class="text-xl font-bold text-white">${p.name}</h3>
                        <span class="text-xs bg-gray-700 px-2 py-1 rounded text-gray-400 uppercase tracking-widest">${currentTab}</span>
                    </div>
                    <p class="text-sm text-gray-300 mb-3">${charLinks}</p>
                    <p class="text-gray-400 italic text-sm border-l-2 border-blue-500 pl-3">${p.desc}</p>
                `;
                grid.appendChild(card);
            });
        }

        function setTab(tab) {
            currentTab = tab;
            document.getElementById('tabFanon').className = tab === 'FANON' ? 'px-6 py-2 tab-active font-semibold' : 'px-6 py-2 font-semibold';
            document.getElementById('tabCanon').className = tab === 'CANON' ? 'px-6 py-2 tab-active font-semibold' : 'px-6 py-2 font-semibold';
            render();
        }

        function filterByChar(char) {
            focusChar = char;
            document.getElementById('focusHeader').classList.remove('hidden');
            document.getElementById('focusText').innerText = `Showing all pairings for: ${char}`;
            render();
        }

        function clearFocus() {
            focusChar = null;
            document.getElementById('focusHeader').classList.add('hidden');
            render();
        }

        document.getElementById('searchInput').addEventListener('input', render);
        render();
    </script>
</body>
</html>

