                { name: "Megilith", chars: ["Megita", "Lilith"], desc: "Foot pic" },
                { name: "Levshu", chars: ["Lev", "Wangshu"], desc: "Affectionate x tsundere" },
                { name: "Rainshu", chars: ["Rainy", "Wangshu"], desc: "Mathuationship" },
                { name: "Rainsum", chars: ["Rainy", "Asum"], desc: "Codependent pookies" },
                { name: "Sayum", chars: ["Saya", "Asum"], desc: "Saya is asum's plaything" },
                { name: "Solsum", chars: ["Sol", "Asum"], desc: "Lemmi's monoship" },
                { name: "Shum", chars: ["Shon", "Asum"], desc: "First follower of jesus type of thingggg" },
                { name: "Adashu", chars: ["Ada", "Wangshu"], desc: "Bad end fell off" },
                { name: "Shuemiyo", chars: ["Wangshu", "Emi", "Miyo"], desc: "Three bottoms" },
                { name: "Rainada", chars: ["Ada", "Rainy"], desc: "Wives" },
                { name: "Adaqer", chars: ["Ada", "Qerfuin"], desc: "Clingy ex-player x shy player" },
                { name: "Adashon", chars: ["Ada", "Shon"], desc: "Toxic alcoholic oomftuationship, ada hides behind shon, co parenting azman, how straight women acts with each other basically" },
                { name: "Lemsol", chars: ["Lemmi", "Sol"], desc: "IDK" },
                { name: "Lemon/Lemshon", chars: ["Lemmi", "Shon"], desc: "Declared love, shon is the redflag one here" },
                { name: "Kiralem", chars: ["Lemmi", "Kirari"], desc: "Amnesia yuri" },
                { name: "Lemmirk", chars: ["Lemmi", "Skirk"], desc: "Yuribait" },
                { name: "Hanalem", chars: ["Hana", "Lemmi"], desc: "Lemmi bottoms" },
                { name: "Kiravi", chars: ["Kirari", "Avi"], desc: "CEO Kirari x Y/N Avi" },
                { name: "Skivivi Toilith", chars: ["Lilith", "Avi"], desc: "Skibidarling till fanum do us tax" },
                { name: "Nomiqer", chars: ["Nomi", "Qerfuin"], desc: "Omega catgirl x alpha" },
                { name: "Lenomi", chars: ["Lemmi", "Nommi"], desc: "Industry plant…" },
                { name: "Shonshu", chars: ["Shon", "Wangshu"], desc: "Math x Engineering, LINKEDIN oomftuationship" },
                { name: "Hanalili", chars: ["Hana", "Lilith"], desc: "Platonic mutual glazing" },
                { name: "Lilish", chars: ["Lilith", "Shon"], desc: "Hana bodyguards" },
